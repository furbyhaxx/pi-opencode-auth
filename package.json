{
  "name": "pi-opencode-auth",
  "version": "0.1.0",
  "description": "Spoofs the OpenCode CLI identity for Pi's built-in opencode/opencode-go providers so Zen's free models work",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": ["pi-package", "pi-extension", "opencode", "zen", "free-tier"],
  "files": ["index.ts", "src", "README.md", "LICENSE"],
  "pi": {
    "extensions": ["./index.ts"]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}
